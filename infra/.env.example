# Copy to /opt/postonce/shared/postonce.env on the reviewed VPS.
# Keep the real file root-owned with mode 0600 and never commit it.
POSTONCE_DOMAIN=postonce.swoop.video
POSTONCE_ORIGIN_PORT=18044
POSTONCE_DEPLOY_ROOT=/opt/postonce
POSTONCE_BACKUP_DIR=/opt/postonce/shared/backups

# Production releases replace these placeholders with immutable GHCR digests.
POSTONCE_API_IMAGE=ghcr.io/yazanbaker94/postonce-api@sha256:replace-with-64-lowercase-hex-characters
POSTONCE_GATEWAY_IMAGE=ghcr.io/yazanbaker94/postonce-gateway@sha256:replace-with-64-lowercase-hex-characters

POSTGRES_DB=postonce
POSTGRES_USER=postonce
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value
DATABASE_URL=postgresql://postonce:replace-with-a-long-random-hex-value@db:5432/postonce

NODE_ENV=production
PORT=3001
DEMO_STORE=postgres
CORS_ORIGINS=https://postonce.swoop.video
DB_POOL_MAX=5
DEMO_MAX_ACTIVE_SESSIONS=500
DEMO_SESSION_TTL_MINUTES=240
DEMO_SESSION_CREATE_LIMIT=12
DEMO_SESSION_CREATE_WINDOW_SECONDS=600
DEMO_SESSION_MUTATION_LIMIT=120
DEMO_SESSION_MUTATION_WINDOW_SECONDS=600
DEMO_RATE_LIMIT_TRACKED_KEYS=4096
BACKUP_RETENTION_DAYS=14
