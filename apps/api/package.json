{
  "name": "@postonce/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NestJS API for the PostOnce failure-safe payment posting demo.",
  "scripts": {
    "prebuild": "npm run build --workspace @postonce/contracts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "typecheck": "npm run build --workspace @postonce/contracts && tsc -p tsconfig.json --noEmit",
    "test": "npm run build --workspace @postonce/contracts && vitest run",
    "test:watch": "vitest",
    "benchmark": "tsx scripts/benchmark.ts",
    "migrate": "node ../../database/migrate.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@postonce/contracts": "*",
    "helmet": "^8.0.0",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "@nestjs/testing": "^11.0.11",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.8"
  }
}
